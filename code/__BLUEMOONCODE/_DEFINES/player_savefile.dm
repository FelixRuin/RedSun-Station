// Открытые savefile игроков и журнал одиночных ключей префов (preferences_savefile.dm).

/// Сколько savefile игроков держим открытыми одновременно. Открытый файл держит в памяти процесса
/// примерно втрое больше своего размера (сейв на 60 слотов - около 3 МБ), поэтому держим немного.
#define PLAYER_SAVEFILE_HOLD_MAX 16
/// Сколько держим открытым savefile, к которому никто не обращается.
#define PLAYER_SAVEFILE_HOLD_IDLE (2 MINUTES)
/// Журнал одиночных ключей крупнее этого уходит в сам savefile, а не дописывается дальше.
#define PREF_JOURNAL_MAX_BYTES (64 * 1024)
/// Журнал, начатый раньше этого срока, не дописывается: сброс уходит в сам savefile и сливает журнал.
/// Столько же правка ждала диска до журнала, так что журнал держит не больше десяти минут правок.
#define PREF_JOURNAL_MAX_AGE (10 MINUTES)
/// Ключ блока журнала с отпечатком savefile на момент начала журнала: если файл с тех пор
/// менялся мимо журнала, блок устарел.
#define PREF_JOURNAL_BASE_KEY "__journal_base"
/// Строка, с которой начинается каждый блок журнала: обрывок до неё (недописанный блок) не читается.
#define PREF_JOURNAL_BLOCK_BEGIN "#single_prefs_block"
/// Строка, которой заканчивается каждый дописанный блок журнала: блок без неё оборван и не читается.
#define PREF_JOURNAL_BLOCK_END "#end_of_single_prefs_block"
/// Ключ поколения в блоках журнала прошлого формата: при чтении пропускается.
#define PREF_JOURNAL_EPOCH_KEY "__journal_epoch"
/// Ключ savefile со счётчиком слияний журнала: его подъём наверняка меняет отпечаток файла.
#define PREF_JOURNAL_EPOCH_SAVE_KEY "journal_epoch"
/// Ключ savefile с отпечатком файла до начатого слияния журнала: слияние, оборванное падением,
/// доводит следующий мир.
#define PREF_JOURNAL_MERGING_SAVE_KEY "journal_merging"
